# Observability Stack Environment Configuration
# Copy to /srv/docker/observability/.env and configure before deployment
#
# IMPORTANT: Keep this file secure (chmod 600)

# =============================================================================
# GRAFANA (REQUIRED)
# =============================================================================
# Admin password - CHANGE THIS before first deployment!
GRAFANA_ADMIN_PASSWORD=changeme_please

# =============================================================================
# SMTP / Email Alerts (Optional but recommended)
# =============================================================================
# For Gmail: Use App Password (not regular password)
# Create at: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com:587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=homelab-alerts@yourdomain.com

# Where to send critical alerts
ALERT_EMAIL=admin@yourdomain.com
