# User Management Alert Rules
# Monitor user account creation, deletion, and modification

groups:
  - name: user_management
    interval: 30s
    rules:
      # ==========================================================================
      # USER CREATION
      # ==========================================================================

      - alert: NewUserCreated
        expr: |
          count_over_time({job="audit", audit_key="user_creation"} [5m]) > 0
        for: 0m
        labels:
          severity: high
          category: user_management
          alert_type: security
        annotations:
          summary: "New user account created: {{ $labels.new_username }}"
          description: "User '{{ $labels.new_username }}' was created by UID {{ $labels.audit_auid }}. Verify this is authorized."
          runbook_url: "https://wiki.internal.com/security/user-created"

      - alert: UserCreatedOffHours
        expr: |
          count_over_time({job="audit", audit_key="user_creation"} [5m]) > 0
          and hour() >= 22
          or hour() < 6
        for: 0m
        labels:
          severity: critical
          category: user_management
          alert_type: security
        annotations:
          summary: "User created during off-hours: {{ $labels.new_username }}"
          description: "User '{{ $labels.new_username }}' created outside business hours (10 PM - 6 AM). High risk indicator."
          runbook_url: "https://wiki.internal.com/security/user-created-offhours"

      - alert: RapidUserCreation
        expr: |
          sum(count_over_time({job="audit", audit_key="user_creation"} [10m])) > 3
        for: 0m
        labels:
          severity: critical
          category: user_management
          alert_type: security
        annotations:
          summary: "Multiple users created rapidly"
          description: "{{ $value }} user accounts created in 10 minutes. Potential automated attack or compromise."
          runbook_url: "https://wiki.internal.com/security/rapid-user-creation"

      # ==========================================================================
      # USER DELETION
      # ==========================================================================

      - alert: UserDeleted
        expr: |
          count_over_time({job="audit", audit_key="user_deletion"} [5m]) > 0
        for: 0m
        labels:
          severity: high
          category: user_management
          alert_type: security
        annotations:
          summary: "User account deleted: {{ $labels.deleted_username }}"
          description: "User '{{ $labels.deleted_username }}' was deleted by UID {{ $labels.audit_auid }}."
          runbook_url: "https://wiki.internal.com/security/user-deleted"

      # ==========================================================================
      # USER MODIFICATION
      # ==========================================================================

      - alert: UserModified
        expr: |
          count_over_time({job="audit", audit_key="user_modification"} [5m]) > 0
        for: 0m
        labels:
          severity: medium
          category: user_management
          alert_type: monitoring
        annotations:
          summary: "User account modified"
          description: "User account modified by UID {{ $labels.audit_auid }} using {{ $labels.user_mgmt_command }}."
          runbook_url: "https://wiki.internal.com/security/user-modified"

      # ==========================================================================
      # PASSWORD CHANGES
      # ==========================================================================

      - alert: PasswordChanged
        expr: |
          count_over_time({job="audit", audit_key="password_change"} [5m]) > 0
        for: 0m
        labels:
          severity: info
          category: user_management
          alert_type: monitoring
        annotations:
          summary: "User password changed"
          description: "Password changed by UID {{ $labels.audit_auid }} using {{ $labels.password_command }}."
          runbook_url: "https://wiki.internal.com/security/password-changed"
